# yaml-language-server: $schema=https://json.schemastore.org/clangd.json
CompileFlags:
    CompilationDatabase: /tmp/sweb
    Remove: [-fno-sync-libcalls]
Index:
  StandardLibrary: false
Completion:
    AllScopes: true
Hover:
    ShowAKA: true
Diagnostics:
    ClangTidy:
        Add:
            - modernize*
            - bugprone-*
        Remove:
            - modernize-use-trailing-return-type
            - modernize-deprecated-headers
            - modernize-avoid-c-arrays
            - bugprone-easily-swappable-parameters
            - bugprone-reserved-identifier
    UnusedIncludes: None
---
If:
    PathMatch: "lib/EASTl/*"
Diagnostics:
    Suppress: "*"
---
If:
    PathMatch: "utils/add-debug/dwarf/*"
Diagnostics:
    Suppress: "*"
---
If:
    PathMatch: "utils/add-debug/elf/*"
Diagnostics:
    Suppress: "*"
